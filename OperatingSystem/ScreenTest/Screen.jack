// File name: projects/12/Screen.jack

/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 512 rows (indexed 0..511, top to bottom)
 * of 256 pixels each (indexed 0..255, left to right). The top left pixel on 
 * the screen is indexed (0,0).
 */
class Screen {
    static boolean color;
    static Array powersOfTwo; // powersOfTwo[i] = 2^i, for i=0..15

    /** Initializes the Screen. */
    function void init() {
        var int i;

        let color = true;
        let powersOfTwo = Array.new(16);
        let i = 1;
        let powersOfTwo[0] = 1;

        while(i < 16) {
            let powersOfTwo[i] = powersOfTwo[i - 1] + powersOfTwo[i - 1];
            let i = i + 1;
        }

        return;
    }

    /** Erases the entire screen. */
    function void clearScreen() {
        var boolean tempColor;

        let tempColor = color;
        let color = 0;

        do Screen.drawRectangle(0, 0, 511, 255);

        let color = tempColor;

        return;
    }

    /** Sets the current color, to be used for all subsequent drawXXX commands.
     *  Black is represented by true, white by false. */
    function void setColor(boolean b) {
        let color = b;

        return;
    }

    /** Draws the (x,y) pixel, using the current color. */
    function void drawPixel(int x, int y) {
        var int address, mod16, value, newValue;

        let address = 16384 + (32 * y) + (x / 16);
        let value = Memory.peek(address);
        let mod16 = x - ((x / 16) * 16);

        if(color) {
            let newValue = powersOfTwo[mod16] | value;
        } else {
            let newValue = ~powersOfTwo[mod16] & value;
        }

        do Memory.poke(address, newValue);

        return;
    }

    /** Draws a line from pixel (x1,y1) to pixel (x2,y2), using the current color. */
    function void drawLine(int x1, int y1, int x2, int y2) {
        var int run, rise, currX, currY, currDiff, runStep, riseStep;

        if((x1 < 0) | (x1 > 511) | (x2 < 0) | (x2 > 511) | (y1 < 0) | (y1 > 255) | (y2 < 0) | (y2 > 255)) {
            do Sys.error(6);
        }

        let currX = 0;
        let currY = 0;
        let currDiff = 0;

        // if the line is going right (x2 is larger than x1)
        let run = x2 - x1;
        let runStep = 1;
        // if the line is going left (x2 is smaller than x1)
        if(run < 0) {
            let runStep = -1;
            let run = run * -1;
        }
        // if the line is vetical (x2 is the same as x1)
        if(run = 0) {
            let runStep = 0;
        }

        // if the line is going down (y2 is larger than y1)
        let rise = y2 - y1;
        let riseStep = 1;
        // if the line is going up (y2 is smaller than y1)
        if(rise < 0) {
            let riseStep = -1;
            let rise = rise * -1;
        }
        // if the line is horizontal (y2 is the same as y1)
        if(rise = 0) {
            let riseStep = 0;
            let currDiff = -1;
        }

        while(~((currX > run) | (currY > rise))) {
            do Screen.drawPixel(x1 + (runStep * currX), y1 + (riseStep * currY));

            if(currDiff < 0) {
                let currX = currX + 1;
                let currDiff = currDiff + rise;
            } else {
                let currY = currY + 1;
                let currDiff = currDiff - run;
            }
        }

        return;
    }

    /** Draws a filled rectangle whose top left corner is (x1, y1)
     * and bottom right corner is (x2,y2), using the current color. */
    function void drawRectangle(int x1, int y1, int x2, int y2) {
        var int currY;

        let currY = y1;

        while((currY < y2) | (currY = y2)) {
            do Screen.drawLine(x1, currY, x2, currY);

            let currY = currY + 1;
        }

        return;
    }

    /** Draws a filled circle of radius r<=181 around (x,y), using the current color. */
    function void drawCircle(int x, int y, int r) {
        var int dy, rSquared, dySquared, squareRoot, currY, xMinus, xPlus;

        let dy = -r;
        let rSquared = r * r;

        if((r > 181) | (x < 0) | (y < 0) | (x > 511) | (y > 255)) {
            do Sys.error(6);

            return;
        }

        while((dy < (r + 1)) & ((y + dy) < 256)) {
            if((y + dy) < 0) {
                let dy = -y;
            }

            let currY = y + dy;
            let dySquared = dy * dy;
            let squareRoot = Math.sqrt(rSquared - dySquared);
            let xMinus = x - squareRoot;
            let xPlus = x + squareRoot;

            if(xMinus < 0) {
                let xMinus = 0;
            }
            if(xPlus > 511) {
                let xPlus = 511;
            }

            do Screen.drawLine(xMinus, currY, xPlus, currY);

            let dy = dy + 1;
        }
        return;
    }
}
