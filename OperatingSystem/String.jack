/**
 * Represents character strings. In addition for constructing and disposing
 * strings, the class features methods for getting and setting individual
 * characters of the string, for erasing the string's last character,
 * for appending a character to the string's end, and more typical
 * string-oriented operations.
 */
class String {
    field Array str;
    field int length;

    /**
     * Constructs a new empty string with a maximum length of maxLength
     * and initial length of 0.
     */
    constructor String new(int maxLength) {
        var int len;

        let len = maxLength;

        if(maxLength < 1) {
            let len = 1;
        }

        let str = Array.new(len);
        let length = 0;

        return this;
    }

    /**
     * Disposes this string.
     */
    method void dispose() {
        do str.dispose();

        return;
    }

    /**
     * Returns the current length of this string.
     */
    method int length() {
        return length;
    }

    /**
     * Returns the character at the j-th location of this string.
     */
    method char charAt(int j) {
        return str[j];
    }

    /**
     * Sets the character at the j-th location of this string to c.
     */
    method void setCharAt(int j, char c) {
        let str[j] = c;

        return;
    }

    /**
     * Appends c to this string's end and returns this string.
     */
    method String appendChar(char c) {
        do setCharAt(length, c);
        let length = length + 1;

        return this;
    }

    /**
     * Erases the last character from this string.
     */
    method void eraseLastChar() {
        do setCharAt(length - 1, 0);
        let length = length - 1;
        return;
    }

    /**
     * Returns the integer value of this string,
     * until a non-digit character is detected.
     */
    method int intValue() {
        var int val, i, digit, digChar;
        var boolean sign;

        let val = 0;
        let i = 0;
        let sign = true;

        while(i < length) {
            let digChar = str[i];

            if(digChar = 45) {
                let sign = false;
            } else {
                if((digChar > 57) | (digChar < 48)) {
                    return val;
                }

                let digit = digChar - 48;
                let val = (val * 10) + digit;
            }

            let i = i + 1;
        }

        if(~sign) {
            let val = val * -1;
        }

        return val;
    }

    /**
     * Sets this string to hold a representation of the given value.
     */
    method void setInt(int val) {
        var String acc;
        var int i, len, absVal;
        var boolean sign;

        let acc = String.new(64);
        let str = Array.new(64);
        let absVal = Math.abs(val);

        if(val < 0) {
            let length = 1;
            let len = 1;

            do setCharAt(0, 45);
        } else {
            let length = 0;
            let len = 0;
        }

        let acc = getIntString(acc, absVal);
        let i = len;
        let length = length + acc.length();

        while(i < length) {
            do setCharAt(i, acc.charAt(i - len));

            let i = i + 1;
        }

        return;
    }

    /**
     * Returns the new line character.
     */
    function char newLine() {
        return 128;
    }

    /**
     * Returns the backspace character.
     */
    function char backSpace() {
        return 129;
    }

    /**
     * Returns the double quote (") character.
     */
    function char doubleQuote() {
        return 34;
    }

    /**
     * Helper recursive function to accumulate the string
     * characters for each digit in a number.
     */
    method String getIntString(String acc, int val){
        var int lastDigit;
        var int c;

        let lastDigit = val - ((val / 10) * 10);
        let c = lastDigit + 48;

        if(val < 10) {
            let acc = acc.appendChar(c);

            return acc;
        }

        let acc = getIntString(acc, val / 10);
        let acc = acc.appendChar(c);

        return acc;
    }
}
