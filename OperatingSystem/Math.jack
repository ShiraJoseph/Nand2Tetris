// File name: projects/12/Math.jack

/**
 * A library of commonly used mathematical functions.
 * Note: Jack compilers implement multiplication and division using OS method calls.
 */
class Math {
    static Array powersOfTwo; // powersOfTwo[i] = 2^i, for i=0..15

    /**
     * Initializes the Math library.
     */
    function void init() {
        var int i;

        let powersOfTwo = Array.new(16);
        let i = 1;
        let powersOfTwo[0] = 1;

        while(i < 16) {
            let powersOfTwo[i] = powersOfTwo[i - 1] + powersOfTwo[i - 1];
            let i = i + 1;
        }

        return;
    }

    /**
     * Returns the absolute value of x.
     */
    function int abs(int x) {
        if(x > -1) {
            return x;
        }

        return -x;
    }

    /**
     * Returns the product of x and y.
     * When a Jack compiler detects the multiplication operator '*' in the
     * program's code, it handles it by invoking this method. In other words,
     * the Jack expressions x*y and multiply(x,y) return the same value.
     */
    function int multiply(int x, int y) {
        var int sum, shiftedX, i;

        let sum = 0;
        let shiftedX = x;
        let i = 0;

        while(i < 16) {
            if(Math.bit(y, i)) {
                let sum = sum + shiftedX;
            }

            let shiftedX = shiftedX + shiftedX;
            let i = i + 1;
        }

        return sum;
    }

    /**
     * Returns the integer part of x/y.
     * When a Jack compiler detects the multiplication operator '/' in the
     * program's code, it handles it by invoking this method. In other words,
     * the Jack expressions x/y and divide(x,y) return the same value.
     */
    function int divide(int x, int y) {
        var int absX, absY, q;
        var boolean isPositive;

        let isPositive = true;
        let absX = x;
        let absY = y;

        if(y < 0) {
            let absY = Math.abs(y);
            let isPositive = ~isPositive;
        }

        if(x < 0) {
            let absX = Math.abs(x);
            let isPositive = ~isPositive;
        }

        if(absY > absX) {
            return 0;
        }

        let q = Math.divideAbs(absX, absY);

        if(~isPositive) {
            return -q;
        }

        return q;
    }

    /**
     * Returns the integer part of the square root of x.
     */
    function int sqrt(int x) {
        var int y, j, square, powerMove;

        let y = 0;
        let j = 7;

        while(j > -1) {
            let powerMove = y + powersOfTwo[j];
            let square = powerMove * powerMove;

            if(~(square > x) & square > 0) {
                let y = powerMove;
            }

            let j = j - 1;
        }

        return y;
    }

    /**
     * Returns the greater number.
     */
    function int max(int a, int b) {
        if(a > b) {
            return a;
        }

        return b;
    }

    /**
     * Returns the smaller number.
     */
    function int min(int a, int b) {
        if(a < b) {
            return a;
        }

        return b;
    }

    /**
     * Private helper to return the i-th bit of the integer x.
     */
    function boolean bit(int x, int i) {
        return x & powersOfTwo[i] = powersOfTwo[i];
    }

    /**
     * Private recursive function to divide absolute values.
     */
    function int divideAbs(int x, int y){
        var int q;

        if(y > x | y < 0) {
            return 0;
        }

        let q = Math.divideAbs(x, y + y);

        if((x - (2 * q * y)) < y) {
            return q + q;
        } else {
            return q + q + 1;
        }
    }

}
