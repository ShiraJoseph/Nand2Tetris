/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */
class Memory {
    static Array ram;
    static int firstFreeSegmentAddr;

    /** Initializes the class. */
    function void init() {
        let ram = 0;
        let firstFreeSegmentAddr = 2048;

        let ram[2048] = 0; // pointer to the next available free segment
        let ram[2049] = 14335; // the size of the free segment

        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return ram[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let ram[address] = value;

        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function int alloc(int size) {// we might need to change int to Array according to some of the discussions
        var int previousSegmentAddr, currSegmentAddr, nextSegmentAddr, currSegmentSize, newSegmentAddr;

        let currSegmentAddr = firstFreeSegmentAddr;
        let previousSegmentAddr = -1;

        while(currSegmentAddr > -1) {
            let nextSegmentAddr = ram[currSegmentAddr];
            let currSegmentSize = ram[currSegmentAddr + 1];
            // First check if the segment is big enough to contain the new object's size.
            if((currSegmentSize = size) | (currSegmentSize > size)) {

            // If the segment size is bigger than size + 2, we need to split the slice.
            // So we need to copy the current segment's pointer to the location at size + 2,
            // and set the size in the address slot after that to the segmentSize minus the size + 2.

                if(currSegmentSize > (size + 2)) {
                    let newSegmentAddr = currSegmentAddr + 2 + size;
                    let ram[newSegmentAddr] = nextSegmentAddr;
                    let ram[newSegmentAddr + 1] = currSegmentSize - (size + 2);
                    let nextSegmentAddr = newSegmentAddr;
                }
                // Then we update the previous segment's pointer to point to the new location.
                // (if this was the first free segment (previousSegmentAddr = -1), then update firstFreeSegmentAddr instead)

                if(previousSegmentAddr = -1) {
                    let firstFreeSegmentAddr = nextSegmentAddr;
                } else {
                    let ram[previousSegmentAddr] = nextSegmentAddr;
                }

                return currSegmentAddr + 2;
            }

            let previousSegmentAddr = currSegmentAddr;
            let currSegmentAddr = nextSegmentAddr;
        }

        do Sys.error(6);

        return -1;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        let ram[o - 2] = firstFreeSegmentAddr;
        let firstFreeSegmentAddr = o - 2;
        return;
    }
}
